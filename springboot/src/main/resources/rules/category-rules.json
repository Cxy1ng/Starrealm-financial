        { "keyword": "寄件|快递|退货", "category": "日常购物" },
        { "keyword": "云服务器|ECS|域名", "category": "数码科技" }
      ],
      "defaultCategory": "日常购物",
      "direction": "支出"
    },
    {
      "pattern": "@adyen\\.com",
      "counterparty": "Adyen 国际结算",
      "category": "文化休闲",
      "direction": "支出"
