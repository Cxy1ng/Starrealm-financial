  "rules": [
    {
      "id": "exp_food_keywords",
      "direction": "支出",
      "category": "餐饮美食",
      "priority": 80,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(外卖|快餐|餐馆|饭店|面馆|面条|小吃|菜馆|烤肉|火锅|米粉|米线|烧烤|卤味|早餐|早点|生煎|肠粉|包子|包坊|烘焙|面包|西点|咖啡|奶茶|果茶|炒饭|便当|快餐店|速食|熟食|熟菜|饮料|饮品|开水|矿泉水|麻辣烫|烤冷面|灌饼|煎饼|炸鸡|鸭脖|烤鸭|美食|料理|炒货|干果|零食|豆腐坊|豆制品|牛杂|羊肉泡馍|牛肉拉面|牛肉面).*",
      "excludes": ["餐具批发", "外卖箱", "骑手服装", "咖啡机设备"]
    },
    {
      "id": "exp_transport_keywords",
      "direction": "支出",
      "category": "交通出行",
      "priority": 80,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(地铁|公交|车票|火车|高铁|客票|打车|出租车|网约车|拼车|顺风车|单车|骑行|加油|加气|充电桩|充电费|过路费|通行费|高速费|停车|泊车|代驾|机票|航空|客运|高速公路|收费公路|公路收费|交通信息中心|城泊通|临停|石油|加油站|加油厂).*",
      "excludes": ["模型车", "玩具车", "车模"]
    },
    {
      "id": "exp_utility_keywords",
      "direction": "支出",
      "category": "生活缴费",
      "priority": 85,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(生活缴费|电费|水费|水费代扣|自来水|燃气费|煤气费|暖气费|供暖|供热|抄表|话费|充值.*元，谨防诈骗|宽带|校园网|水控充值|物业费|卫生费|税务局|税务局.*消费|税收缴款).*",
      "excludes": ["电费计算器", "水管维修工具"]
    },
    {
      "id": "exp_entertainment_keywords",
      "direction": "支出",
      "category": "文化休闲",
      "priority": 75,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(影音|音乐|VIP连续包月|月卡|季卡|年卡|会员充值|游戏充值|游戏道具|点券|皮肤|抽卡|门票|电影票|密室|剧本杀|桌游|KTV|健身房|瑜伽|滑雪|景区|度假|温泉|考试院|CET.*考试|考试费|学杂费|重修费|培训费|文化艺术).*",
      "excludes": []
    },
    {
      "id": "exp_digital_keywords",
      "direction": "支出",
      "category": "数码科技",
      "priority": 70,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(数码|显卡|主板|CPU|内存条|固态硬盘|显示器|手机|平板|iPad|MacBook|耳机|外设|机械键盘|鼠标|充电线|手机壳|软件订阅|域名|云服务器|API.*token|Copilot).*",
      "excludes": ["红富士", "水果苹果", "苹果干"]
    },
    {
      "id": "exp_health_keywords",
      "direction": "支出",
      "category": "医疗健康",
      "priority": 85,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(门诊|挂号|医院|卫生院|诊所|大药房|药店|医药|药业|胶囊|颗粒|注射液|感冒|消炎|医疗保险|保费|体检|口腔|牙科|近视|配镜|隐形眼镜|医疗险|重疾险|健康险|意外险|水滴保险|保险经纪).*",
      "excludes": ["药膳火锅"]
    },
    {
      "id": "exp_transfer_keywords",
      "direction": "支出",
      "category": "红包转账",
      "priority": 90,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(微信红包|发红包|转账给|向.*转账|微信转账|群收款|二维码收款|扫二维码付款|AA收款|人情礼金|份子钱).*",
      "excludes": ["返还", "退款"]
    },
    {
      "id": "exp_shopping_keywords",
      "direction": "支出",
      "category": "日常购物",
      "priority": 60,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(超市|便利店|百货|日杂|母婴|服饰|服装|鞋|包|化妆品|洗护|纸巾|洗衣液|家居|家纺|厨具|快递|寄件|寄件费|自提柜|旗舰店|电商|专营店|直营店|生鲜|果蔬|菜市场|菜市|市集|小卖部|杂货铺|食杂|调料|食品店|食品商店|海鲜|水产|烟酒|商行|理发|美发|发艺|美甲|剪发|体育|商场|购物中心).*",
      "excludes": []
    },
    {
      "id": "inc_refund_rules",
      "direction": "收入",
      "category": "退款返还",
      "priority": 100,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(退款|退还|退差价|退货款|已全额退款|部分退款|押金退还|订单取消退款).*",
      "excludes": []
    },
    {
      "id": "inc_salary_rules",
      "direction": "收入",
      "category": "工资薪金",
      "priority": 95,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(薪资|代发工资|工资|薪酬|劳务报酬|年终奖|季度奖|月度绩效|津贴).*",
      "excludes": []
    },
    {
      "id": "inc_transfer_rules",
      "direction": "收入",
      "category": "红包转账",
      "priority": 90,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(收到红包|红包|微信红包|收到口令红包|转账收款|收到转账|转账存入|亲友转账|AA收款).*",
      "excludes": ["退款"]
    },
    {
      "id": "inc_investment_rules",
      "direction": "收入",
      "category": "投资理财",
      "priority": 85,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(理财收益|结息|基金分红|股票收益|赎回|余额宝.*收益|零钱通.*收益|活期结息|利息入账).*",
      "excludes": []
    },
    {
      "id": "inc_side_gig_rules",
      "direction": "收入",
      "category": "副业外快",
      "priority": 80,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(平台激励|创作分成|短视频.*激励|短视频.*收益|收益提现|网易BUFF出售|BUFF.*出售|饰品出售|接单劳务|兼职报酬|佣金提现).*",
      "excludes": []
    },
    {
      "id": "inc_subsidy_rules",
      "direction": "收入",
      "category": "补贴奖励",
      "priority": 85,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(退税|个税退税|税务局|政府补贴|技能提升补贴|国家助学金|奖学金|育儿补贴|以旧换新补贴).*",
      "excludes": []
    },
    {
      "id": "inc_secondhand_rules",
      "direction": "收入",
      "category": "二手闲置",
      "priority": 75,
      "matchFields": ["DETAIL", "PAYEE"],
      "regex": ".*(闲鱼|转转|拍拍|二手出售|出闲置|二手回血).*",
      "excludes": []
    }
  ],
  "nativeFallbacks": [
    {
      "pattern": "群收款|微信红包|转账|扫二维码付款",
      "direction": "支出",
      "category": "红包转账"
    },
    {
      "pattern": "收到红包|群收款|转账|扫二维码付款",
      "direction": "收入",
      "category": "红包转账"
    },
    {
      "pattern": "退款|退还",
      "direction": "收入",
      "category": "退款返还"
    }
  ]
}
