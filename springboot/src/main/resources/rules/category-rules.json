      "defaultCategory": "交通出行",
      "direction": "支出"
    },
    {
      "pattern": "@apple\\.com",
      "counterparty": "Apple 数字服务",
      "category": "数码科技",
      "direction": "支出"
    },
    {
      "pattern": "@service\\.aliyun\\.com",
      "counterparty": "菜鸟物流/阿里云",
