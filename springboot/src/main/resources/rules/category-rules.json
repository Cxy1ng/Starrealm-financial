  "domainPatterns": [
    {
      "pattern": "@autonavi\\.com",
      "counterparty": "高德打车",
      "category": "交通出行",
      "direction": "支出"
    },
    {
      "pattern": "@service\\.netease\\.com",
      "counterparty": "网易公司 (NetEase)",
      "category": "文化休闲",
      "direction": "支出"
    },
    {
      "pattern": "@alibaba-inc\\.com",
      "counterparty": "阿里巴巴外卖/电商",
      "detailMatches": [
        { "keyword": "外卖|餐|鸡|生煎|米线|面", "category": "餐饮美食" },
        { "keyword": "超市|天猫|淘宝|日用", "category": "日常购物" }
