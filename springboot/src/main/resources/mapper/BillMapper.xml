<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cxy1ng.mapper.BillMapper">
    <sql id="Base_Column_List">
        id,time,category,payee,detail,type,amount,payment,status,comment,user_id
    </sql>

    <select id="selectAll" resultType="com.cxy1ng.entity.Bill">
        select
        bill.*, user.username as userName
        from bill
        left join user
        on bill.user_id = user.id
        <where>
            <if test="category != null"> and bill.category like concat('%', #{category}, '%')</if>
            <if test="type != null"> and bill.type = #{type}</if>
            <if test="userName != null"> and user.username like concat('%', #{userName}, '%')</if>
            <if test="userId != null"> and bill.user_id = #{userId}</if>
            <if test="start != null"> and bill.time >= #{start}</if>
            <if test="end != null"> and bill.time &lt;= #{end}</if>
            <if test="ids != null and ids != ''">
                and bill.id in
                <foreach collection="idsArr" open="(" close=")" separator="," item="id">
                    #{id}
                </foreach>
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.cxy1ng.entity.Bill">
        select
        <include refid="Base_Column_List" />
        from bill
        where id = #{id}
    </select>

    <select id="selectCategoryByType" resultType="java.lang.String">
        select distinct category from bill where type =#{type}
    </select>

    <delete id="deleteById">
        delete from bill
        where id = #{id}
    </delete>

    <insert id="insert" parameterType="com.cxy1ng.entity.Bill" useGeneratedKeys="true" keyProperty="id">
        insert into bill
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="time != null">time,</if>
            <if test="category != null">category,</if>
            <if test="payee != null">payee,</if>
            <if test="detail != null">detail,</if>
            <if test="type != null">type,</if>
            <if test="amount != null">amount,</if>
            <if test="payment != null">payment,</if>
            <if test="status != null">status,</if>
            <if test="comment != null">comment,</if>
            <if test="userId != null">user_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="time != null">#{time},</if>
            <if test="category != null">#{category},</if>
            <if test="payee != null">#{payee},</if>
            <if test="detail != null">#{detail},</if>
            <if test="type != null">#{type},</if>
            <if test="amount != null">#{amount},</if>
            <if test="payment != null">#{payment},</if>
            <if test="status != null">#{status},</if>
            <if test="comment != null">#{comment},</if>
            <if test="userId != null">#{userId},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.cxy1ng.entity.Bill">
        update bill
        <set>
            <if test="time != null">
                time = #{time},
            </if>
            <if test="category != null">
                category = #{category},
            </if>
            <if test="payee != null">
                payee = #{payee},
            </if>
            <if test="detail != null">
                detail = #{detail},
            </if>
            <if test="type != null">
                type = #{type},
            </if>
            <if test="amount != null">
                amount = #{amount},
            </if>
            <if test="payment != null">
                payment = #{payment},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="comment != null">
                comment = #{comment},
            </if>
            <if test="userId != null">
                user_id = #{userId},
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>
