<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cxy1ng.mapper.AcfunMapper">
    <sql id="Base_Column_List">
        id,user_id,balance,income,pay
    </sql>

    <select id="selectAll" resultType="com.cxy1ng.entity.Acfun">
        select
        acfun.*, user.username as userName
        from acfun
        left join user
        on acfun.user_id = user.id
        <where>
            <if test="userName != null"> and user.username like concat('%', #{userName}, '%') </if>
            <if test="userId != null"> and acfun.user_id = #{userId} </if>
        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.cxy1ng.entity.Acfun">
        select
        <include refid="Base_Column_List" />
        from acfun
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from acfun
        where  id = #{id}
    </delete>

    <insert id="insert" parameterType="com.cxy1ng.entity.Acfun" useGeneratedKeys="true" keyProperty="id">
        insert into acfun
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null">user_id,</if>
            <if test="balance != null">balance,</if>
            <if test="income != null">income,</if>
            <if test="pay != null">pay,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="balance != null">#{balance},</if>
            <if test="income != null">#{income},</if>
            <if test="pay != null">#{pay},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.cxy1ng.entity.Acfun">
        update acfun
        <set>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="balance != null">
                balance = #{balance},
            </if>
            <if test="income != null">
                income = #{income},
            </if>
            <if test="pay != null">
                pay = #{pay},
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>
