<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cxy1ng.mapper.AdminMapper">

    <sql id="Base_Column_List">
        id,username,nickname,pwd,avatar,phone,email,perm,role,api_key
    </sql>

    <select id="selectAll" resultType="com.cxy1ng.entity.Admin">
        select
        <include refid="Base_Column_List" />
        from admin
        <where>
            <if test="id != null"> and id = #{id}</if>
            <if test="username != null"> and username like concat('%', #{username}, '%')</if>
            <if test="nickname != null"> and nickname = #{nickname}</if>
            <if test="pwd != null"> and pwd = #{pwd}</if>
            <if test="avatar != null"> and avatar = #{avatar}</if>
            <if test="phone != null"> and phone = #{phone}</if>
            <if test="email != null"> and email = #{email}</if>
            <if test="perm != null"> and perm = #{perm}</if>
            <if test="role != null"> and role = #{role}</if>
        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.cxy1ng.entity.Admin">
        select
        <include refid="Base_Column_List"/>
        from admin
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from admin
        where id = #{id}
    </delete>

    <insert id="insert" parameterType="com.cxy1ng.entity.Admin">
        insert into admin
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="username != null">username,</if>
            <if test="nickname != null">nickname,</if>
            <if test="pwd != null">pwd,</if>
            <if test="avatar != null">avatar,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="perm != null">perm,</if>
            <if test="role != null">role,</if>
            <if test="apiKey != null">api_key,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="username != null">#{username},</if>
            <if test="nickname != null">#{nickname},</if>
            <if test="pwd != null">#{pwd},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="perm != null">#{perm},</if>
            <if test="role != null">#{role},</if>
            <if test="apiKey != null">#{apiKey},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.cxy1ng.entity.Admin">
        update admin
        <set>
            <if test="id != null">
                id = #{id},
            </if>
            <if test="username != null">
                username = #{username},
            </if>
            <if test="nickname != null">
                nickname = #{nickname},
            </if>
            <if test="pwd != null">
                pwd = #{pwd},
            </if>
            <if test="avatar != null">
                avatar = #{avatar},
            </if>
            <if test="phone != null">
                phone = #{phone},
            </if>
            <if test="email != null">
                email = #{email},
            </if>
            <if test="perm != null">
                perm = #{perm},
            </if>
            <if test="role != null">
                role = #{role},
            </if>
            <if test="apiKey != null">
                api_key = #{apiKey},
            </if>
        </set>
        where id = #{id}
    </update>
</mapper>
